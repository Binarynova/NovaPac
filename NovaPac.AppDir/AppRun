#!/bin/bash
HERE="$(dirname "$(readlink -f "${0}")")"

# Explicitly check if the target OS is SteamOS (Steam Deck)
if grep -iq "steamos" /etc/os-release 2>/dev/null; then
    echo "[NovaPac] SteamOS detected. Deferring to native system OpenAL to prevent PipeWire conflicts."
    export LD_LIBRARY_PATH="${HERE}/usr/bin:${LD_LIBRARY_PATH}"
else
    echo "[NovaPac] Standard Linux detected. Injecting bundled OpenAL fallback..."
    # Pushing our bundled libs folder to the very front of the dynamic linker queue
    export LD_LIBRARY_PATH="${HERE}/usr/bin/libs:${HERE}/usr/bin:${LD_LIBRARY_PATH}"
fi

# Launch the emulator
exec "${HERE}/usr/bin/NovaPac" "$@"
